// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git": {
    "file_diff": {
      "show_full_file": false
    }
  },
  "wsl_connections": [
    {
      "distro_name": "Ubuntu",
      "user": null,
      "projects": []
    }
  ],
  "cli_default_open_behavior": "existing_window",
  "languages": {
    "Rust": {
      "formatter": "language_server",
      "format_on_save": "on",
      "wrap_guides": [100],
    },
    "TOML": {
      "language_servers": ["tombi", "cargo-tom"],
    },
    "GDScript": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "C:\\Users\\valen\\bin\\gdscript-formatter.exe",
        },
      },
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": true,
        "check": {
          "command": "clippy",
        },
        "hover": {
          "show": {
            "fields": 50,
          },
        },
        "inlayHints": {
          "maxLength": null,
          "expressionAdjustmentHints": {
            "enable": "always",
            "mode": "prefix",
          },
        },
      },
      "binary": {
        "ignore_system_version": true,
      },
      "fetch": {
        "pre_release": true,
      },
    },
    "cargo-tom": {
      // "initialization_options": {
      //   "offline": false,
      //   "stable_version": true,
      //   "per_page": 25,
      // },
    },
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "markdown_preview": {
    "max_width": 10000.0,
  },
  "markdown_preview_font_size": 15.0,
  "edit_predictions": {
    "allow_data_collection": "default",
  },
  "colorize_brackets": true,
  "semantic_tokens": "off",
  "document_folding_ranges": "off",
  "document_symbols": "off",
  "inlay_hints": {
    "show_background": false,
    "enabled": true,
    "show_value_hints": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
  },
  "always_treat_brackets_as_autoclosed": false,
  "line_ending": "enforce_lf",
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "indent_aware",
    "enabled": true,
  },
  "preferred_line_length": 80,
  "toolbar": {
    "code_actions": true,
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": true,
    "breadcrumbs": true,
  },
  "minimap": {
    "thumb": "always",
    "show": "never",
  },
  "gutter": {
    "runnables": true,
  },
  "relative_line_numbers": "disabled",
  "auto_signature_help": false,
  "sticky_scroll": {
    "enabled": false,
  },
  "mouse_wheel_zoom": true,
  "scroll_beyond_last_line": "one_page",
  "helix_mode": false,
  "vim_mode": false,
  "show_wrap_guides": true,
  "selection_highlight": true,
  "rounded_selection": true,
  "cursor_shape": "bar",
  "proxy": "",
  "disable_ai": true,
  "project_panel": {
    "scrollbar": {
      "show": "auto",
    },
    "entry_spacing": "comfortable",
    "dock": "left",
  },
  "completion_menu_item_kind": "symbol",
  "completion_menu_scrollbar": "always",
  "completions": {
    "lsp": true,
  },
  "terminal": {
    "shell": "system",
  },
  "autosave": "on_focus_change",
  "prettier": {
    "parser": "",
    "allowed": true,
  },
  "format_on_save": "on",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
  },
  "base_keymap": "JetBrains",
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "JetBrains Islands Dark",
  },
}
